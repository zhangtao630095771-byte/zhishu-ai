# 环境变量与凭据
.env
.env.*
!.env.example
*.pem
*.key

# 数据库及备份（知识库+账号含密码哈希；*.bak 匹配不了带日期后缀的备份，单独列出）
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
*.db.bak-*
*.db.promptbak-*
*.bak
# ★ 带日期/后缀的备份文件（如 index.html.bak-semantic-20261116-092749），*.bak 匹配不到
*.bak-*
*.backup
# ★ 整个前端备份目录（如 frontend.bak-20261117-databuddy），820K 旧源码副本，不入库
*.bak-*/
frontend.bak-*/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/

# embedding 模型缓存（约 91MB，按 requirements 重新下载即可）
models/

# 日志与临时文件
*.log
logs/
tmp/
temp/
_t_*.py

# 系统文件
.DS_Store
Thumbs.db

# 本地配置及运行数据
data/

# IDE
