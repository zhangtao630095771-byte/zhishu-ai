# ═══════════════════════════════════════════════════════════
# 知数AI · 生产环境变量模板（公司内网 · 直连 ClickHouse 部署）
#
#   用法：cp prod.env.example .env.prod   然后按真实值填写
#        docker compose 会用 env_file: .env.prod 注入容器
# ═══════════════════════════════════════════════════════════
#
# ★ 与开发机 .env 的三点关键区别：
#   ① 【不设 SSH 隧道】SSH_HOST / SSH_USER / SSH_PASSWORD 一律不填 ——
#      生产机必须与 ClickHouse 同内网/VPC，直连 CK_HOST
#      （代码在没配 SSH_HOST 时就是直连模式）。
#   ② CK_HOST 填内网真实地址，不是 127.0.0.1 隧道。
#   ③ 显式配 ADMIN_INITIAL_PASSWORD，否则系统随机生成、只在首启日志打印一次，容易搞丢。


# ── 大模型（必填）──
DEEPSEEK_API_KEY=sk-你的Key

# ── 数据源（生产用 clickhouse）──
DB_TYPE=clickhouse

# ── ClickHouse 内网直连（必填）──
# ★ CK_USER 必须是【只读账号】，且只 GRANT SELECT 给白名单表（第一道防线）
CK_HOST=<内网CK真实地址>
CK_PORT=8123
CK_USER=<只读账号名>
CK_PASSWORD=<只读账号密码>
CK_DATABASE=ctc_data_warehouse

# 查询保护（防止一句话拖垮集群）
CK_MAX_EXECUTION_SEC=30
CK_MAX_RESULT_ROWS=10000
MAX_RESULT_ROWS=1000
MAX_QUERY_MEMORY=12000000000
MAX_QUERY_TIMEOUT=120

# 连接复用（★ 性能关键，别关：建连接 8.3s vs 复用 0.05s）
CK_CONN_REUSE=1
CK_CONN_MAX_AGE=600

# ── 首次初始化管理员（必填）──
# 登录后系统会强制改密；不要在这里放长期密码
ADMIN_INITIAL_PASSWORD=<初始密码>

# ── 安全：表访问白名单模式（强烈建议 false）──
ACL_DEFAULT_VISIBLE=false

# ── 知识库存储（★ 必配，指到挂载卷，容器重建不丢）──
CONFIG_DB=/app/data/agent_config.db

# ── Embedding（内网零联网启动）──
EMBED_CACHE_DIR=models
EMBED_LOCAL_ONLY=1

# ── 结果缓存 ──
RESULT_CACHE_TTL=120
RESULT_CACHE_MAX=200
RESULT_CACHE_KFP_TTL=30

# ── 尾段并行（自然语言回答 ∥ 事后自审）──
TAIL_PARALLEL=1

# ── 需求一致性审核（灰度期 block 必须保持 0 = 只告警不阻断）──
REQ_REVIEW_ENABLED=1
REQ_REVIEW_BLOCK=0
