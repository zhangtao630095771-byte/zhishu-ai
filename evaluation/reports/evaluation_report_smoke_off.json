      "question": "查询2025年全年的注册客户数，注册司机数，发单客户数",
      "ok": true,
      "error": "",
      "sql": "SELECT\n  COALESCE((SELECT COUNT(DISTINCT id) FROM ctc_data_warehouse.ods_tu_customer_all WHERE create_data_time >= toDateTime('2025-01-01 00:00:00') AND create_data_time < toDateTime('2026-01-01 00:00:00')), 0) AS `注册客户数`,\n  COALESCE((SELECT COUNT(DISTINCT id) FROM ctc_data_warehouse.ods_tu_driver_all WHERE create_data_time >= toDateTime('2025-01-01 00:00:00') AND create_data_time < toDateTime('2026-01-01 00:00:00')), 0) AS `注册司机数`,\n  COALESCE((SELECT COUNT(DISTINCT t.customer) FROM (\n      SELECT customer_id AS customer FROM ctc_data_warehouse.ods_tu_large_handcart_order_all WHERE order_time >= toDateTime('2025-01-01 00:00:00') AND order_time < toDateTime('2026-01-01 00:00:00')\n      UNION ALL\n      SELECT customer AS customer FROM ctc_data_warehouse.dwd_tu_order_all WHERE order_type = 1 AND toDateTime(ctime) >= toDateTime('2025-01-01 00:00:00') AND toDateTime(ctime) < toDateTime('2026-01-01 00:00:00')\n      UNION ALL\n      SELECT customer_id AS customer FROM ctc_data_warehouse.ods_valet_order_all WHERE order_time >= toDateTime('2025-01-01 00:00:00') AND order_time < toDateTime('2026-01-01 00:00:00')\n  ) AS t WHERE t.customer IS NOT NULL), 0) AS `发单客户数`",
