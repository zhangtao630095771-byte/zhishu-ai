# ═══════════════════════════════════════════════════════════
# 环境变量模板 —— 复制成 .env 后按需修改
#     cp .env.example .env
# ★ .env 绝不会提交到代码仓库（里面是密钥），本文件可以随便分享
# ═══════════════════════════════════════════════════════════

# ── 大模型（必填）──
# 去 https://platform.deepseek.com 注册，在「API Keys」里创建
DEEPSEEK_API_KEY=sk-你的Key粘贴在这里


# ═══════════════════════════════════════════════════════════
# 数据源选择
# ═══════════════════════════════════════════════════════════
# sqlite     = 本地演示库（开箱即用，适合先跑通流程）
# clickhouse = 公司真实数仓
DB_TYPE=sqlite


# ── ClickHouse（DB_TYPE=clickhouse 时必填）──
# ★ CK_USER 必须是【只读账号】，别用 default
# ★ 建号与授权脚本见 ck_demo_setup.sql 底部
CK_HOST=<内网CK_HOST>
CK_PORT=8123
CK_USER=<只读账号名>
# ★ 本文件是【可分享的模板】，绝不要把真实密码写进来（原来这里就是真实密码，已清掉）。
#   真实密码只放 .env（已在 .gitignore / .dockerignore 中排除）。
CK_PASSWORD=你的只读账号密码
CK_DATABASE=ctc_data_warehouse

# 查询保护（防止一句自然语言拖垮集群）
CK_MAX_EXECUTION_SEC=30
CK_MAX_RESULT_ROWS=10000


# ═══════════════════════════════════════════════════════════
# Embedding 模型（RAG 用）
# ═══════════════════════════════════════════════════════════
# 模型缓存目录。默认放项目内的 models/，好处是能跟代码一起部署到内网。
EMBED_CACHE_DIR=models

# 1 = 只用本地缓存不联网（生产/内网推荐）
# 0 = 本地没有就去下载（第一次准备模型时用）
EMBED_LOCAL_ONLY=1

# ★ 内网下载不了模型时的两个临时环境变量（跑完就可以去掉）：
#     export HF_ENDPOINT=https://hf-mirror.com     # 走国内镜像
#     export HF_HUB_DISABLE_XET=1                  # 禁用 HF 的新传输协议（国内常被拦）


# ═══════════════════════════════════════════════════════════
# 知识库存储位置（★ 部署时必看）
# ═══════════════════════════════════════════════════════════
# agent_config.db 里装的是【全部知识资产】+ 账号：
#   Prompt 定制 / 指标口径 / 字段注释 / 数据字典 / 实体关系 / 用户 / 反馈
# 它是整个系统最值钱的东西，绝不能让它在重建时丢掉。
#
# 默认（不设该项）= 当前工作目录下的 agent_config.db，开发环境就好。
# 容器/服务器部署：指到持久化目录，并把这个目录做好备份，例如
#   CONFIG_DB=/app/data/agent_config.db     （配 -v zhishu-data:/app/data）
#   CONFIG_DB=/data/zhishu/agent_config.db  （裸机/虚拟机）
# CONFIG_DB=agent_config.db


# ═══════════════════════════════════════════════════════════
# 服务监听地址（影响"同事能不能访问"）
# ═══════════════════════════════════════════════════════════
# 由 serve.sh 读取，不是本程序读的。
#   127.0.0.1 = 只有本机能访问（默认，最安全）
#   0.0.0.0   = 监听所有网卡，同内网的同事可访问
# 用法：HOST=0.0.0.0 ./serve.sh -d
# HOST=127.0.0.1


# ═══════════════════════════════════════════════════════════
# 安全与权限
# ═══════════════════════════════════════════════════════════
# 表访问默认策略：
#   true  = 黑名单模式（没登记的表默认【可见】，只屏蔽显式标记的）
#   false = 白名单模式（没登记的表默认【不可见】，必须逐个授权）
#
# ★★ 接真实库时强烈建议改成 false（白名单模式）！
#    真实库有几百张表，黑名单模式下"默认全部可见"——
#    你只想开放 3 张，剩下几百张 AI 全都看得见。
#    白名单模式才是"我明确允许的才能看"，语义正确也更安全。
#
# ★ 真实库的【第一道防线】是数据库账号本身：
#    给 AI 用的账号只 GRANT SELECT 给需要的那几张表，
#    这样连表名都不会告诉它（ClickHouse 的 system.tables 会按授权过滤）。
#    代码层的 ACL 是第二道防线（用于"授权了但不想让 AI 查"这种更细的场景）。
ACL_DEFAULT_VISIBLE=false

# SQL 执行失败时最多重试几次（自愈纠错）
MAX_RETRY=3

# 结果最多返回/显示多少行（防止刷屏，也是防大查询的一道保险）
MAX_RESULT_ROWS=1000
MAX_ROWS_PRINT=10
