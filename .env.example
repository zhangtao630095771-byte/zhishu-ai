# ═══════════════════════════════════════════════════════════
# 环境变量模板 —— 复制成 .env 后按需修改
#     cp .env.example .env
# ★ .env 绝不会提交到代码仓库（里面是密钥），本文件可以随便分享
# ═══════════════════════════════════════════════════════════

# ── 大模型（必填）──
# 去 https://platform.deepseek.com 注册，在「API Keys」里创建
DEEPSEEK_API_KEY=sk-你的Key粘贴在这里


# ═══════════════════════════════════════════════════════════
# 数据源选择
# ═══════════════════════════════════════════════════════════
# sqlite     = 本地演示库（开箱即用，适合先跑通流程）
# clickhouse = 公司真实数仓
DB_TYPE=sqlite


# ── ClickHouse（DB_TYPE=clickhouse 时必填）──
# ★ CK_USER 必须是【只读账号】，别用 default
# ★ 建号与授权脚本见 ck_demo_setup.sql 底部
CK_HOST=<内网CK_HOST>
# ★ 端口变量名必须是 CK_PORT（config.py 读取的是这个名字）。
CK_PORT=8123
CK_USER=<只读账号名>
# ★ 本文件是【可分享的模板】，绝不要把真实密码写进来（原来这里就是真实密码，已清掉）。
#   真实密码只放 .env（已在 .gitignore / .dockerignore 中排除）。
CK_PASSWORD=你的只读账号密码
# ★ 目标库名（config.py 读取 CK_DATABASE）
CK_DATABASE=ctc_data_warehouse

# 查询保护（防止一句自然语言拖垮集群）
CK_MAX_EXECUTION_SEC=30
CK_MAX_RESULT_ROWS=10000

# ── 连接复用（★ 性能关键，别关）──
#   实测：新建连接 8.3 秒，复用连接查询 0.05 秒 —— 建连接是查询的 70 倍开销。
#   开启后每线程保持一条长连接；断线（SSH 隧道重建）会自动重连并重试一次。
CK_CONN_REUSE=1
#   连接空闲超过这个秒数就丢弃重建（防止拿到已被中间设备掐死的连接）
CK_CONN_MAX_AGE=600

# ── 尾段并行：自然语言回答 ∥ 事后自审 ──
#   两步互不依赖，串行约 6.9s，并行约 5.0s。返回结构不变，前端无需改动。
#   置 0 退回串行（排障对比用）。
TAIL_PARALLEL=1


# ═══════════════════════════════════════════════════════════
# Embedding 模型（RAG 用）
# ═══════════════════════════════════════════════════════════
# 模型缓存目录。默认放项目内的 models/，好处是能跟代码一起部署到内网。
EMBED_CACHE_DIR=models

# 1 = 只用本地缓存不联网（生产/内网推荐）
# 0 = 本地没有就去下载（第一次准备模型时用）
EMBED_LOCAL_ONLY=1

# ★ 内网下载不了模型时的两个临时环境变量（跑完就可以去掉）：
#     export HF_ENDPOINT=https://hf-mirror.com     # 走国内镜像
#     export HF_HUB_DISABLE_XET=1                  # 禁用 HF 的新传输协议（国内常被拦）


# ═══════════════════════════════════════════════════════════
# 知识库存储位置（★ 部署时必看）
# ═══════════════════════════════════════════════════════════
# agent_config.db 里装的是【全部知识资产】+ 账号：
#   Prompt 定制 / 指标口径 / 字段注释 / 数据字典 / 实体关系 / 用户 / 反馈
# 它是整个系统最值钱的东西，绝不能让它在重建时丢掉。
#
# 默认（不设该项）= 当前工作目录下的 agent_config.db，开发环境就好。
# 容器/服务器部署：指到持久化目录，并把这个目录做好备份，例如
#   CONFIG_DB=/app/data/agent_config.db     （配 -v zhishu-data:/app/data）
#   CONFIG_DB=/data/zhishu/agent_config.db  （裸机/虚拟机）
# CONFIG_DB=agent_config.db


# ═══════════════════════════════════════════════════════════
# 服务监听地址（影响"同事能不能访问"）
# ═══════════════════════════════════════════════════════════
# 由 serve.sh 读取，不是本程序读的。
#   127.0.0.1 = 只有本机能访问（默认，最安全）
#   0.0.0.0   = 监听所有网卡，同内网的同事可访问
# 用法：HOST=0.0.0.0 ./serve.sh -d
# HOST=127.0.0.1


# ═══════════════════════════════════════════════════════════
# 安全与权限
# ═══════════════════════════════════════════════════════════
# 表访问默认策略：
#   true  = 黑名单模式（没登记的表默认【可见】，只屏蔽显式标记的）
#   false = 白名单模式（没登记的表默认【不可见】，必须逐个授权）
#
# ★★ 接真实库时强烈建议改成 false（白名单模式）！
#    真实库有几百张表，黑名单模式下"默认全部可见"——
#    你只想开放 3 张，剩下几百张 AI 全都看得见。
#    白名单模式才是"我明确允许的才能看"，语义正确也更安全。
#
# ★ 真实库的【第一道防线】是数据库账号本身：
#    给 AI 用的账号只 GRANT SELECT 给需要的那几张表，
#    这样连表名都不会告诉它（ClickHouse 的 system.tables 会按授权过滤）。
#    代码层的 ACL 是第二道防线（用于"授权了但不想让 AI 查"这种更细的场景）。
ACL_DEFAULT_VISIBLE=false

# SQL 执行失败时最多重试几次（自愈纠错）
MAX_RETRY=3

# ═══════════════════════════════════════════════════════════
# 知识治理：生产检索是否严格只认 approved
# ═══════════════════════════════════════════════════════════
#   true （代码默认）= 只有 approved 进检索。AI 新抽取的知识先落 candidate，
#                      需跑 `python _review_governance.py apply` 复核后才生效。
#   false           = 过渡期放宽，candidate 也进检索（召回不会缩水，但未复核
#                      的 AI 知识会污染口径，不建议长期开着）。
# 改动前后建议跑 `python _governance_impact.py` 看影响面。
# GOVERNANCE_STRICT_STATUS=true


# 结果最多返回/显示多少行（防止刷屏，也是防大查询的一道保险）
MAX_RESULT_ROWS=1000
MAX_ROWS_PRINT=10

# ═══════════════════════════════════════════════════════════
# 取数结果缓存（result_cache.py）
# ═══════════════════════════════════════════════════════════
#   一次取数要 20~90 秒（LLM 生成 + ClickHouse 执行 + 列中文名解析），
#   而日报/周报类问题高度重复。命中缓存的典型耗时是 0.03~0.2 秒。
#
#   ★ 缓存 key 已包含：问题 + 用户 + 角色 + 可见表指纹 + 知识指纹 + 方言 + 模型 + 经验开关。
#     改口径 / 改权限 / 改模型 / 切经验开关 → 自动失效，不会串号。
#   ★ 只缓存成功结果；失败与降级结果不缓存（避免把偶发故障固化成稳定故障）。
#   ★ 索引重建（/api/index/rebuild）会立即清空缓存。
#
#   TTL=0 表示彻底关闭（评测、对账、排障时建议关掉）。
RESULT_CACHE_TTL=120
RESULT_CACHE_MAX=200
# 知识指纹自身缓存秒数（越长，"改了知识但缓存没失效"的窗口越大）
RESULT_CACHE_KFP_TTL=30

# ═══════════════════════════════════════════════════════════
# SQL 经验中心（sql_experience.py）
# ═══════════════════════════════════════════════════════════
#   总开关；关掉后取数完全回到接入经验之前的行为。
# EXP_ENABLED=1
#   成功经验检索 / 失败经验预防 / 归纳规则注入
# EXP_SUCCESS_RECALL=1
# EXP_FAIL_PREVENT=1
# EXP_RULES=1
#   命中已知坏 SQL 后自动修一轮（默认关：会多一次 LLM 调用）
# EXP_FAIL_REPAIR=0
#   高相似时直接复用黄金 SQL（默认关：跳过生成，风险高于收益）
# EXP_EXACT_REUSE=0


# ═══════════════════════════════════════════════════════════
# 需求一致性审核（requirement_review.py）
# ═══════════════════════════════════════════════════════════
#   解决的问题：五维校验只判断"SQL 合不合法"，不判断"SQL 合不合题意"。
#   典型漏网：替换写成追加（"只看101"→ `=0 OR =101`）、
#             去掉分组顺手删过滤、漏 GROUP BY 塌成一行。
#
#   总开关（0 = 完全回到改造前行为）
REQ_REVIEW_ENABLED=1
#   触发范围：always | modify_only | off
#   modify_only（默认）：只审增量修改 / 含修改动词 / 有歧义的场景，成本可控
REQ_REVIEW_MODE=modify_only
#   语义层开关（P2 实现；置 0 = 只跑零成本的确定性规则）
REQ_REVIEW_LLM=1
#   是否阻断执行。★ 灰度期必须保持 0（只告警），
#   等误拦率(合法 SQL 被拦比例) < 5% 再改 1。
REQ_REVIEW_BLOCK=0
#   语义层单次超时（秒）；超时一律记 skipped，绝不当成"通过"
REQ_REVIEW_TIMEOUT=8
#   增量修改时，经验检索是否带上上一轮问题一起做 embedding
#   （"再加完成率"这种短问句单靠自身几乎召不回基线案例）
EXP_MODIFY_CTX=1
